@inproceedings{shen_temporal_2025,
	location = {Singapore},
	title = {Temporal Preference and Knowledge-Aware Collaborative Attentive Network for Electrical Material Recommendation},
	isbn = {978-981-96-0570-5},
	doi = {10.1007/978-981-96-0570-5_10},
	abstract = {In the field of electrical power material management, it is paramount that users receive accurate recommendations regarding the electrical power materials they require. In recent years, increasing attention has been given to Knowledge Graph-based recommender systems for their capacity to effectively tackle cold start and data sparsity challenges. However, many of these systems still lack the capability to consider users’ historical behavioral patterns and model dynamic changes in user interests. To remedy this gap, the paper proposes an Electrical Material Recommendation model based on Temporal Preference and Knowledge aware collaborative attentive network, named {EMR}-{TPK}. {EMR}-{TPK} establishes associations between users and materials through knowledge graph embedding along with an attention mechanism. It utilizes a temporal dynamic attention network to characterize users’ temporal interests and historical behavioral patterns. By incorporating these patterns into the model, more accurate material recommendations can be generated. We conducted extensive experiments across three datasets: electric power materials, music, and books. Our results indicate that the {EMR}-{TPK} model exceeds advanced methods in recommendation accuracy, with {AUC} improvements of 0.36\% for electric power materials, 0.95\% for music, and 2.54\% for books.},
	pages = {133--147},
	booktitle = {Web Information Systems Engineering – {WISE} 2024},
	publisher = {Springer Nature},
	author = {Shen, Jie and Chen, Lei and Zhu, Guixiang and Cao, Jie and Qin, Weiping and Chen, Yihan and Lu, Yiheng},
	editor = {Barhamgi, Mahmoud and Wang, Hua and Wang, Xin},
	date = {2025},
	langid = {english},
	keywords = {/unread, Knowledge Graph, Recommender Systems, Temporal Information},
	annotation = {📋 文章元信息标题: Temporal Preference and Knowledge-Aware Collaborative Attentive Network for Electrical Material Recommendation作者: Shen Jie；Chen Lei；Zhu Guixiang；Cao Jie；Qin Weiping；Chen Yihan；Lu Yiheng；Barhamgi Mahmoud；Wang Hua；Wang Xin发表年份: 2025日期: 2025出版社: Springer {NatureDOI}: 10.1007/978-981-96-0570-5\_10标签: /unread；Knowledge Graph；Recommender Systems；Temporal Information񇐠文章内容In the field of electrical power material management, it is paramount that users receive accurate recommendations regarding the electrical power materials they require. In recent years, increasing attention has been given to Knowledge Graph-based recommender systems for their capacity to effectively tackle cold start and data sparsity challenges. However, many of these systems still lack the capability to consider users’ historical behavioral patterns and model dynamic changes in user interests. To remedy this gap, the paper proposes an Electrical Material Recommendation model based on Temporal Preference and Knowledge aware collaborative attentive network, named {EMR}-{TPK}. {EMR}-{TPK} establishes associations between users and materials through knowledge graph embedding along with an attention mechanism. It utilizes a temporal dynamic attention network to characterize users’ temporal interests and historical behavioral patterns. By incorporating these patterns into the model, more accurate material recommendations can be generated. We conducted extensive experiments across three datasets: electric power materials, music, and books. Our results indicate that the {EMR}-{TPK} model exceeds advanced methods in recommendation accuracy, with {AUC} improvements of 0.36\% for electric power materials, 0.95\% for music, and 2.54\% for books.},
}

@inproceedings{zhu_deep_2026,
	title = {Deep Learning-Driven Intelligent {THz} Communications for 6G Urban Air Mobility: Channel Prediction and {URLLC} Assurance},
	url = {https://ieeexplore.ieee.org/abstract/document/11642056},
	doi = {10.1109/CCAI69603.2026.11642056},
	shorttitle = {Deep Learning-Driven Intelligent {THz} Communications for 6G Urban Air Mobility},
	abstract = {With the rapid evolution of sixth-generation (6G) mobile communications, urban air mobility ({UAM}) networks have emerged as a key pillar to achieve the vision of ubiquitous space-air-ground connectivity. Although the terahertz ({THz}) frequency band is regarded as a critical technological enabler for supporting real-time, high-bandwidth {UAM} services due to its abundant spectrum resources, {THz} waves suffer severe propagation attenuation and are highly sensitive to dynamic fluctuations in atmospheric conditions. In this paper, we propose an intelligent {THz} communication system model tailored for 6G {UAM} networks. By incorporating a data-driven machine learning ({ML}) framework, the proposed model enhances the system's adaptability to dynamic environments through the deep integration of physical propagation priors with intelligent algorithms. Based on the established system model, a deep learning-driven channel prediction and ultra-reliable low-latency communications ({URLLC}) assurance mechanism is introduced. Using the powerful nonlinear feature extraction capabilities of deep neural networks ({DNNs}), the system can identify latent atmospheric fading patterns from complex {THz} propagation paths, thereby providing proactive channel state information ({CSI}) for unmanned aerial vehicle ({UAV}) nodes. This predictive approach effectively mitigates the latency bottlenecks inherent in traditional reactive methods when dealing with rapidly changing spatiotemporal features. Extensive numerical simulations demonstrate that the proposed intelligent model significantly outperforms traditional benchmark schemes in terms of prediction accuracy and system throughput under extreme attenuation and highdynamic scenarios. Finally, the results confirm the significant advantages of this scheme in maintaining ultra-low end-to-end response latency, providing a robust solution for optimizing {THz} communication performance in complex maritime or urban environments.},
	eventtitle = {2026 6th International Conference on Computer Communication and Artificial Intelligence ({CCAI})},
	pages = {672--677},
	booktitle = {2026 6th International Conference on Computer Communication and Artificial Intelligence ({CCAI})},
	author = {Zhu, Guixiang and Ou, Yuqin and Sun, Qi and Miao, Jiaqi and Sun, Dasong and Zhou, Beiping},
	urldate = {2026-11-04},
	date = {2026-05},
	keywords = {/unread, 6G, Absorption, Autonomous aerial vehicles, Beams, Channel prediction, Deep learning, Equations, Modeling, Printing, Propagation, Terahertz communications, Ultra reliable low latency communication, Urban air mobility},
	annotation = {📋 文章元信息标题: Deep Learning-Driven Intelligent {THz} Communications for 6G Urban Air Mobility: Channel Prediction and {URLLC} Assurance作者: Zhu Guixiang；Ou Yuqin；Sun Qi；Miao Jiaqi；Sun Dasong；Zhou Beiping发表年份: 2026日期: 2026-05DOI: 10.1109/{CCAI}69603.2026.11642056URL: https://ieeexplore.ieee.org/abstract/document/11642056标签: /unread；6G；Absorption；Autonomous aerial vehicles；Beams；Channel prediction；Deep learning；Equations；Modeling；Printing；Propagation；Terahertz communications；Ultra reliable low latency communication；Urban air mobility񇐠文章内容With the rapid evolution of sixth-generation (6G) mobile communications, urban air mobility ({UAM}) networks have emerged as a key pillar to achieve the vision of ubiquitous space-air-ground connectivity. Although the terahertz ({THz}) frequency band is regarded as a critical technological enabler for supporting real-time, high-bandwidth {UAM} services due to its abundant spectrum resources, {THz} waves suffer severe propagation attenuation and are highly sensitive to dynamic fluctuations in atmospheric conditions. In this paper, we propose an intelligent {THz} communication system model tailored for 6G {UAM} networks. By incorporating a data-driven machine learning ({ML}) framework, the proposed model enhances the system's adaptability to dynamic environments through the deep integration of physical propagation priors with intelligent algorithms. Based on the established system model, a deep learning-driven channel prediction and ultra-reliable low-latency communications ({URLLC}) assurance mechanism is introduced. Using the powerful nonlinear feature extraction capabilities of deep neural networks ({DNNs}), the system can identify latent atmospheric fading patterns from complex {THz} propagation paths, thereby providing proactive channel state information ({CSI}) for unmanned aerial vehicle ({UAV}) nodes. This predictive approach effectively mitigates the latency bottlenecks inherent in traditional reactive methods when dealing with rapidly changing spatiotemporal features. Extensive numerical simulations demonstrate that the proposed intelligent model significantly outperforms traditional benchmark schemes in terms of prediction accuracy and system throughput under extreme attenuation and highdynamic scenarios. Finally, the results confirm the significant advantages of this scheme in maintaining ultra-low end-to-end response latency, providing a robust solution for optimizing {THz} communication performance in complex maritime or urban environments.},
	file = {Snapshot:E\:\\文献\\zotero\\storage\\MBTAM6NY\\11642056.html:text/html},
}

@inproceedings{zhu_fas-enabled_2026,
	title = {{FAS}-Enabled Anti-{SSDF} Cooperative Spectrum Sensing: A Novel Physical-Layer Security Framework},
	url = {https://ieeexplore.ieee.org/abstract/document/11642099},
	doi = {10.1109/CCAI69603.2026.11642099},
	shorttitle = {{FAS}-Enabled Anti-{SSDF} Cooperative Spectrum Sensing},
	abstract = {Cognitive radio ({CR}) has emerged as a promising solution to meet the spectrum demands of massive sensor networks; however, cooperative spectrum sensing ({CSS}) remains highly vulnerable to spectrum sensing data falsification ({SSDF}) attacks. In this paper, we investigate the physical-layer security of {CSS} from a fluid antenna system ({FAS}) perspective and propose a robust anti-{SSDF} framework by exploiting spatial adaptability. A cognitive wireless radio network ({CWRN}) with {FAS}-enabled secondary users is formulated, where each sensor dynamically selects antenna positions over a continuous aperture, inducing spatial decorrelation and channel randomness. Based on these properties, a spatial-consistency-based defense mechanism and a {FAS}-assisted secure fusion strategy are developed to effectively suppress coordinated and intelligent {SSDF} attacks. To further enhance security, we propose a novel {FAS}-Machine Learning hybrid scheme that integrates deep learning with {FAS} spatial diversity for adaptive attack detection. Simulation results demonstrate that the proposed scheme significantly enhances sensing accuracy and robustness under various attack scenarios and fusion rules, while maintaining low hardware complexity, highlighting the effectiveness of {FAS} as a physical-layer security enabler for {CSS}. The proposed framework achieves up to 25\% higher detection accuracy compared to existing methods under cooperative {SSDF} attacks, with only 15\% additional computational overhead.},
	eventtitle = {2026 6th International Conference on Computer Communication and Artificial Intelligence ({CCAI})},
	pages = {587--592},
	booktitle = {2026 6th International Conference on Computer Communication and Artificial Intelligence ({CCAI})},
	author = {Zhu, Guixiang and Meng, Yujia and Chen, Tao and Zhou, Beiping and Xie, Zhiyi and Chen, Yihan},
	urldate = {2026-11-04},
	date = {2026-05},
	keywords = {/unread, Antennas, Cognitive radio, cooperative spectrum sensing, Decorrelation, Equations, fluid antenna systems, Fluids, Image sensors, machine learning, Machine learning, Modeling, physical-layer security, Printing, Security, Signal detection, spatial correlation},
	annotation = {📋 文章元信息标题: {FAS}-Enabled Anti-{SSDF} Cooperative Spectrum Sensing: A Novel Physical-Layer Security Framework作者: Zhu Guixiang；Meng Yujia；Chen Tao；Zhou Beiping；Xie Zhiyi；Chen Yihan发表年份: 2026日期: 2026-05DOI: 10.1109/{CCAI}69603.2026.11642099URL: https://ieeexplore.ieee.org/abstract/document/11642099标签: /unread；Antennas；Cognitive radio；cooperative spectrum sensing；Decorrelation；Equations；fluid antenna systems；Fluids；Image sensors；machine learning；Machine learning；Modeling；physical-layer security；Printing；Security；Signal detection；spatial correlation񇐠文章内容Cognitive radio ({CR}) has emerged as a promising solution to meet the spectrum demands of massive sensor networks; however, cooperative spectrum sensing ({CSS}) remains highly vulnerable to spectrum sensing data falsification ({SSDF}) attacks. In this paper, we investigate the physical-layer security of {CSS} from a fluid antenna system ({FAS}) perspective and propose a robust anti-{SSDF} framework by exploiting spatial adaptability. A cognitive wireless radio network ({CWRN}) with {FAS}-enabled secondary users is formulated, where each sensor dynamically selects antenna positions over a continuous aperture, inducing spatial decorrelation and channel randomness. Based on these properties, a spatial-consistency-based defense mechanism and a {FAS}-assisted secure fusion strategy are developed to effectively suppress coordinated and intelligent {SSDF} attacks. To further enhance security, we propose a novel {FAS}-Machine Learning hybrid scheme that integrates deep learning with {FAS} spatial diversity for adaptive attack detection. Simulation results demonstrate that the proposed scheme significantly enhances sensing accuracy and robustness under various attack scenarios and fusion rules, while maintaining low hardware complexity, highlighting the effectiveness of {FAS} as a physical-layer security enabler for {CSS}. The proposed framework achieves up to 25\% higher detection accuracy compared to existing methods under cooperative {SSDF} attacks, with only 15\% additional computational overhead.},
}

@inproceedings{yang_epcg_2023,
	location = {New York, {NY}, {USA}},
	title = {{EPCG}: An Elite Population Co-evolutionary Genetic Algorithm for Global Community Deception},
	isbn = {978-1-4503-9751-3},
	url = {https://dl.acm.org/doi/10.1145/3580219.3580232},
	doi = {10.1145/3580219.3580232},
	series = {{CCEAI} '23},
	shorttitle = {{EPCG}},
	abstract = {Community detection algorithms are able to mine and analyze community structures, which plays an important part in practical applications. However, for the purpose of privacy protection, some communities do not want to be mined and analyzed. For this reason, researchers introduced the community deception, which aims to destroy the effectiveness of community detection algorithms for the purpose of privacy protection. In this paper, we propose an Elite Population Co-evolutionary Genetic ({EPCG}) algorithm for global community deception, in which we design two different fitness functions based on Normalized Mutual Information ({NMI}) and elite population coevolution mechanisms respectively. Extensive experiments are conducted on four real networks against three classical community detection algorithms. The results validate that our method is outperforming the baseline method.},
	pages = {66--71},
	booktitle = {Proceedings of the 7th International Conference on Control Engineering and Artificial Intelligence},
	publisher = {Association for Computing Machinery},
	author = {Yang, Shuxin and Chen, Baizhen and Zhu, Guixiang},
	urldate = {2026-11-03},
	date = {2023-03-02},
	keywords = {/unread, Community deception, Community detection, Genetic algorithm, Privacy protection},
