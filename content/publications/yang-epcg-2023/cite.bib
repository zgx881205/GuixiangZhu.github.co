@inproceedings{yang_epcg_2023,
 abstract = {Community detection algorithms are able to mine and analyze community structures, which plays an important part in practical applications. However, for the purpose of privacy protection, some communities do not want to be mined and analyzed. For this reason, researchers introduced the community deception, which aims to destroy the effectiveness of community detection algorithms for the purpose of privacy protection. In this paper, we propose an Elite Population Co-evolutionary Genetic (EPCG) algorithm for global community deception, in which we design two different fitness functions based on Normalized Mutual Information (NMI) and elite population coevolution mechanisms respectively. Extensive experiments are conducted on four real networks against three classical community detection algorithms. The results validate that our method is outperforming the baseline method.},
 annotation = {📋 文章元信息标题: EPCG: An Elite Population Co-evolutionary Genetic Algorithm for Global Community Deception作者: Yang Shuxin；Chen Baizhen；Zhu Guixiang发表年份: 2023日期: 2023-03-02出版社: Association for Computing MachineryDOI: 10.1145/3580219.3580232URL: https://dl.acm.org/doi/10.1145/3580219.3580232标签: /unread；Community deception；Community detection；Genetic algorithm；Privacy protection񇐠文章内容Community detection algorithms are able to mine and analyze community structures, which plays an important part in practical applications. However, for the purpose of privacy protection, some communities do not want to be mined and analyzed. For this reason, researchers introduced the community deception, which aims to destroy the effectiveness of community detection algorithms for the purpose of privacy protection. In this paper, we propose an Elite Population Co-evolutionary Genetic (EPCG) algorithm for global community deception, in which we design two different fitness functions based on Normalized Mutual Information (NMI) and elite population coevolution mechanisms respectively. Extensive experiments are conducted on four real networks against three classical community detection algorithms. The results validate that our method is outperforming the baseline method.},
